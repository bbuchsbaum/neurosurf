new file mode 100644
index 0000000..82f1572
--- /dev/null
+++ b/src/layers/ReferenceLayer.ts
@@ -0,0 +1,13 @@
+import { RGBALayer } from '../layers';
+import type { LayerConfig } from '../layers';
+
+/** Full binary vertex membership, rendered categorically at fragment level. */
+export class ReferenceLayer extends RGBALayer {
+  constructor(id: string, readonly membership: Float32Array,
+              readonly color: readonly number[], config: LayerConfig) {
+    super(id, new Float32Array(membership.length * 4), config);
+    if (membership.some(value => value !== 0 && value !== 1)) {
+      throw new Error('Reference membership must be finite and binary');
+    }
+  }
+}
