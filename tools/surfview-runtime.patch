diff --git a/tests/unit/report-reference.test.ts b/tests/unit/report-reference.test.ts
new file mode 100644
index 0000000..2773a5c
--- /dev/null
+++ b/tests/unit/report-reference.test.ts
@@ -0,0 +1,94 @@
+/** @vitest-environment jsdom */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { makeReportFixture } from './report-scene-fixture';
+import { ReferenceLayer } from '../../src/layers/ReferenceLayer';
+import { ReportControls } from '../../src/report/ReportControls';
+import { createSurfViewControlSession } from '../../src/controls/ControlSession';
+
+beforeEach(() => {
+  vi.stubGlobal('requestAnimationFrame', () => 1);
+  vi.stubGlobal('cancelAnimationFrame', vi.fn());
+});
+afterEach(() => vi.unstubAllGlobals());
+
+function fixture() {
+  const f = makeReportFixture();
+  f.manifest.schemaVersion = 'surfview.scene.reference.v1';
+  f.manifest.layers.psl = {
+    id: 'psl', role: 'reference', color: '#0000FF', boundary: 'linear-membership>=0.5',
+    colorMap: ['#0000FF', '#0000FF'], limits: [0, 1], opacity: 0.2, visible: true,
+    values: { lh: { values: 'lh-psl' }, rh: { values: 'rh-psl' } },
+    provenance: { source: 'synthetic' }
+  };
+  for (const surface of [f.left, f.right]) {
+    surface.addLayer(new ReferenceLayer('psl', new Float32Array([0, 1, 1, 0]),
+      [0, 0, 1], { opacity: 0.2, order: -1 }));
+  }
+  return f;
+}
+
+describe('binary report reference', () => {
+  it('preserves reference controls and order across exclusive map switches and reset', () => {
+    const f = fixture();
+    const session = createSurfViewControlSession(f.target);
+    const address = { surfaceId: 'lh', layerId: 'psl' };
+    const before = f.target.getSnapshot();
+    try {
+      const notifications: unknown[] = [];
+      const subscription = f.target.subscribe(snapshot => notifications.push(snapshot));
+      notifications.length = 0;
+      expect(session.setLayerOpacity(address, 0.7)).toEqual({ ok: true });
+      expect(notifications).toHaveLength(1);
+      subscription.unsubscribe();
+      expect(f.target.getSnapshot().capabilities.referenceLayers).toEqual({
+        availability: { enabled: true }, layerIds: ['psl']
+      });
+      expect(session.setLayerVisibility(address, false)).toEqual({ ok: true });
+      for (const map of ['uncertainty', 'response']) {
+        expect(session.setDisplayedLayer(map)).toEqual({ ok: true });
+        const snapshot = f.target.getSnapshot();
+        expect(snapshot.capabilities.exclusiveMap?.availableLayerIds).toEqual(['response', 'uncertainty']);
+        for (const s of snapshot.surfaces) {
+          expect(s.layers.find(l => l.id === 'psl')).toMatchObject({ opacity: 0.7, visible: false });
+          expect(s.layers.filter(l => ['response', 'uncertainty'].includes(l.id) && l.visible)).toHaveLength(1);
+          expect(s.layers.findIndex(l => l.id === 'psl')).toBeLessThan(s.layers.findIndex(l => l.id === map));
+        }
+      }
+      expect(f.target.setDisplayedLayer('psl')).toMatchObject({ ok: false });
+      expect(session.setLayerVisibility({ surfaceId: 'lh', layerId: 'response' }, false)).toMatchObject({ ok: false });
+      expect(session.setLayerOpacity(address, NaN)).toMatchObject({ ok: false });
+      expect(session.setLayerVisibility({ surfaceId: 'missing', layerId: 'psl' }, true)).toMatchObject({ ok: false });
+      expect(session.resetView()).toEqual({ ok: true });
+      expect(before.surfaces[0]?.layers.find(l => l.id === 'psl')).toMatchObject({ opacity: 0.2, visible: true });
+      for (const s of f.target.getSnapshot().surfaces) {
+        expect(s.layers.find(l => l.id === 'psl')).toMatchObject({ opacity: 0.2, visible: true });
+      }
+      expect(f.target.setInspectionSelection({ kind: 'vertex', surfaceId: 'lh', vertexIndex: 1 })).toEqual({ ok: true });
+      expect(f.target.getSnapshot().selection.inspection?.values.some(v => v.layerId === 'psl')).toBe(false);
+    } finally { session.dispose(); f.dispose(); }
+    expect(f.target.setLayerOpacity(address, 0.5)).toMatchObject({ ok: false, code: 'disposed' });
+  });
+
+  it('provides a separate labelled native checkbox, opacity slider and categorical key', () => {
+    const f = fixture();
+    const controls = new ReportControls(f.target);
+    try {
+      const group = controls.element.querySelector('[aria-label="Anatomical reference"]')!;
+      expect(group.hasAttribute('hidden')).toBe(false);
+      const select = controls.element.querySelector('select')!;
+      expect(Array.from(select.options).map(o => o.value)).toEqual(['response', 'uncertainty']);
+      const checkbox = group.querySelector('input[type="checkbox"]') as HTMLInputElement;
+      checkbox.checked = false;
+      checkbox.dispatchEvent(new Event('change'));
+      expect(f.left.getLayer('psl')?.visible).toBe(false);
+      const range = group.querySelector('input[type="range"]') as HTMLInputElement;
+      range.value = '0.6'; range.dispatchEvent(new Event('input'));
+      expect(f.right.getLayer('psl')?.opacity).toBe(0.6);
+      expect(group.textContent).toContain('psl');
+    } finally { controls.dispose(); f.dispose(); }
+  });
+
+  it('rejects non-binary membership', () => {
+    expect(() => new ReferenceLayer('bad', new Float32Array([0, 0.3, 1]), [0, 0, 1], {})).toThrow('binary');
+  });
+});
